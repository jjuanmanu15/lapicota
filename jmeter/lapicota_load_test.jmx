<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Lapicota - Plan de Pruebas de Carga">
      <stringProp name="TestPlan.comments">
        Sistema Penitenciario Lapicota - Docker Swarm + HAProxy
        TG1: Smoke Test     (5 usuarios, 1 iteracion) - ACTIVO
        TG2: Carga Lectura  (50 usuarios, 5 min)      - desactivar TG1 primero
        TG3: Carga Escritura(20 usuarios, 5 min)      - desactivar TG1 primero
        TG4: Stress Test    (200 usuarios, 10 min)    - solo para medicion de limite
      </stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables Globales">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">192.168.100.2</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT_USUARIOS" elementType="Argument">
            <stringProp name="Argument.name">PORT_USUARIOS</stringProp>
            <stringProp name="Argument.value">3001</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT_VISITAS" elementType="Argument">
            <stringProp name="Argument.name">PORT_VISITAS</stringProp>
            <stringProp name="Argument.value">3002</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT_INCIDENTES" elementType="Argument">
            <stringProp name="Argument.name">PORT_INCIDENTES</stringProp>
            <stringProp name="Argument.value">3003</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROTOCOLO" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOLO</stringProp>
            <stringProp name="Argument.value">http</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
