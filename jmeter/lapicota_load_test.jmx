            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;tipo_incidente&quot;:&quot;PELEA&quot;,&quot;descripcion&quot;:&quot;Incidente de prueba de carga - thread ${__threadNum}&quot;,&quot;fecha_incidente&quot;:&quot;2026-05-21&quot;,&quot;hora_incidente&quot;:&quot;14:00:00&quot;,&quot;estado_incidente&quot;:&quot;PENDIENTE&quot;}</stringProp>
